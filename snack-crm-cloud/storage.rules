rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSnackStaff() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@snackprogram\\.org$');
    }

    match /grant-documents/{allPaths=**} {
      allow read, write: if isSnackStaff();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
